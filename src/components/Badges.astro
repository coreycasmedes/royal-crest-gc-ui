---
// Single-color vector logos (fill="currentColor"), inlined so they take the
// text colour. Heights are tuned per logo so they read at the same visual
// weight: GAF is a solid block, CertainTeed a long wordmark.
import Gaf from '@/assets/logos/gaf.svg'
import Brava from '@/assets/logos/brava.svg'
import CertainTeed from '@/assets/logos/certainteed.svg'
import AbcSupply from '@/assets/logos/abc-supply.svg'

const logos = [
  { Logo: Gaf, size: 'h-[22px] sm:h-7 lg:h-9' },
  { Logo: Brava, size: 'h-6 sm:h-8 lg:h-10' },
  { Logo: CertainTeed, size: 'h-5 sm:h-6 lg:h-8' },
  { Logo: AbcSupply, size: 'h-[26px] sm:h-8 lg:h-[42px]' },
]
---

<section class="py-10 lg:py-14 bg-bg">
  <div class="max-w-[1260px] mx-auto px-8 lg:px-12 flex flex-col gap-7 lg:flex-row lg:items-center lg:gap-12">
    <p class="shrink-0 text-center lg:text-left lg:max-w-[10rem] lg:border-r lg:border-text/10 lg:pr-12 text-[0.72rem] font-semibold tracking-[0.22em] uppercase leading-relaxed text-text/65">
      Certified installer
    </p>

    <ul class="flex flex-1 items-center justify-between gap-4 sm:justify-around">
      {logos.map(({ Logo, size }) => (
        <li class="flex">
          <Logo class={`${size} w-auto text-text/55 transition-colors duration-300 hover:text-text`} />
        </li>
      ))}
    </ul>
  </div>
</section>
