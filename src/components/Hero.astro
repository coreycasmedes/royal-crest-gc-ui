---
import VideoText from './ui/VideoText.astro'
import droneRoofVideo from '@/assets/drone_roof_540.mp4'
import droneRoofPoster from '@/assets/drone_roof_poster.webp'
import { IconPhone } from '@tabler/icons-react'
import { HERO } from '@/lib/hero'
import { callLabel, telHref } from '@/lib/business'

// Phones get four short lines; from md up, three longer ones fill the wider box.
const staticHeadlineLines = ['Exterior and', 'Interior Finishes', 'on Historic and', 'Modern Homes']
const wideHeadlineLines = ['Exterior and Interior', 'Finishes on Historic', 'and Modern Homes']
// Inside the mask, vw is a percentage of the mask box. The longest line is about 8.1em
// ("Interior Finishes") or 10.2em ("Exterior and Interior") wide, so these keep it inside the box.
const HEADLINE_FONT_SIZE = 'clamp(1.8rem, 9.5vw, 6rem)'
const WIDE_HEADLINE_FONT_SIZE = 'clamp(1.8rem, 8.6vw, 7rem)'
const HEADLINE_LINE_HEIGHT_EM = 1.05
const headlineHeight = (lineCount: number, fontSize: string) => `calc(${lineCount} * ${HEADLINE_LINE_HEIGHT_EM} * ${fontSize})`
---

<section id="hero" class="relative flex flex-col items-center justify-center bg-bg" style="padding-top: 88px">
  <div class="w-full max-w-7xl mx-auto px-8 py-10 md:py-16 lg:px-12">
    <h1
      class="relative font-heading z-10 mx-auto max-w-4xl md:max-w-none text-center font-black leading-tight tracking-tight text-text"
      style="font-size: clamp(2.4rem, 7vw, 6rem)"
    >
      <div
        class="mx-auto w-full h-(--headline-h) md:h-(--headline-h-wide)"
        style={`--headline-h: ${headlineHeight(staticHeadlineLines.length, HEADLINE_FONT_SIZE)}; --headline-h-wide: ${headlineHeight(wideHeadlineLines.length, WIDE_HEADLINE_FONT_SIZE)}`}
      >
        <VideoText
          src={droneRoofVideo}
          poster={droneRoofPoster.src}
          playbackRate={0.5}
          lineHeight={HEADLINE_LINE_HEIGHT_EM}
          fontSize={HEADLINE_FONT_SIZE}
          fontWeight={700}
          letterSpacing="-0.04em"
          class="font-heading"
          lines={staticHeadlineLines}
          wide={{ lines: wideHeadlineLines, fontSize: WIDE_HEADLINE_FONT_SIZE }}
        />
      </div>
    </h1>

    {/* MobileActionBar hides while #hero-actions is on screen */}
    <div id="hero-actions" class="animate-hero-actions relative z-10 mt-8 flex flex-wrap items-center justify-center gap-2">
      <a
        href={telHref}
        class="inline-flex min-w-52 items-center justify-center gap-2 rounded-2xl px-6 py-3 text-[0.78rem] font-semibold tracking-[0.08em] uppercase bg-deep text-bg hover:bg-accent-ink transition-colors duration-300"
      >
        <IconPhone aria-hidden="true" className="h-4 w-4" stroke={2} />
        {callLabel}
      </a>
      <a
        href="#contact"
        class="min-w-52 rounded-2xl text-center border border-text/20 text-text px-6 py-3 text-[0.78rem] font-semibold tracking-[0.08em] uppercase hover:border-text transition-colors duration-300"
      >
        Get a Quote
      </a>
    </div>

    {/* LCP element: no entrance animation, no lazy loading */}
    <div class="relative z-10 mt-16 p-3">
      <div class="w-full overflow-hidden">
        <img
          src={HERO.src}
          srcset={HERO.srcset}
          sizes={HERO.sizes}
          alt="Residential exterior with copper roofline built by Royal Crest in Dallas, TX"
          width={HERO.width}
          height={HERO.height}
          fetchpriority="high"
          decoding="async"
          class="aspect-[4/3] lg:aspect-[2/1] h-auto w-full object-cover rounded-2xl"
          style="filter: saturate(0.82) brightness(1.02)"
        />
      </div>
    </div>
  </div>
</section>
