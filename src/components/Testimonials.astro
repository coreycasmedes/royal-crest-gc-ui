---
import { BUSINESS } from '@/lib/business'
import { TESTIMONIALS, type Testimonial } from '@/lib/testimonials'

interface Props {
  items?: Testimonial[]
}

const { items = TESTIMONIALS } = Astro.props
const LINK_CLASS = 'border-b border-text text-text hover:text-accent-ink hover:border-accent-ink transition-colors duration-200'
const LG_COLUMNS = ['lg:grid-cols-1', 'lg:grid-cols-2', 'lg:grid-cols-3'][Math.min(items.length, 3) - 1]
---

<section id="testimonials" class="py-24 lg:py-28 bg-bg">
  <div class="max-w-[1260px] mx-auto px-8 lg:px-12">
    <div data-reveal class="mb-12 lg:mb-16 reveal">
      <h2
        class="font-heading font-bold leading-tight text-text"
        style="font-size: clamp(2.2rem, 4vw, 3.2rem)"
      >
        What Clients Say
      </h2>
      <p class="mt-4 text-[0.95rem] text-text/70">
        Rated 5 stars on{' '}<a href={BUSINESS.reviews.google} class={LINK_CLASS}>Google</a>{' '}and{' '}<a href={BUSINESS.reviews.yelp} class={LINK_CLASS}>Yelp</a>.
      </p>
    </div>

    <div data-reveal="0.08" class={`grid grid-cols-1 gap-4 ${LG_COLUMNS}`}>
      {items.map((t, i) => (
        <figure class={`reveal delay-${i + 1} shadow-input flex flex-col rounded-xl border border-surface bg-bg p-6 sm:p-8`}>
          <blockquote>
            <p class="text-[1.1rem] leading-[1.65] text-pretty text-text">&ldquo;{t.quote}&rdquo;</p>
          </blockquote>
          <figcaption class="mt-auto pt-8">
            <span class="block font-heading font-bold text-[0.98rem] leading-snug text-text">{t.name}</span>
            <span class="block mt-0.5 text-sm text-text/65">{t.designation}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
