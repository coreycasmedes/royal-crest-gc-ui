---
import { BUSINESS } from '@/lib/business'
---

<section id="stats" class="py-20 bg-bg">
  <div data-reveal class="max-w-[1260px] mx-auto px-8 lg:px-12">
    <div class="grid grid-cols-3">
      {BUSINESS.stats.map(({ num, label }, i) => (
        <div class={`text-center px-2 sm:px-6 py-4 border-r last:border-r-0 border-surface reveal delay-${i + 1}`}>
          <p
            class="font-heading font-black leading-none mb-2 text-text"
            style="font-size: clamp(1.9rem, 8vw, 4rem)"
          >
            {num}
          </p>
          <p class="text-[0.6rem] sm:text-[0.7rem] font-medium tracking-[0.1em] sm:tracking-[0.18em] uppercase text-text/70">
            {label}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
