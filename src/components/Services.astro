---
import { IconHome2, IconHomeCog, IconHammer, IconFence } from '@tabler/icons-react'
import ServiceCard from './ui/ServiceCard.astro'
import backyardDeckImg from '@/assets/backyard_deck1.webp'
import gutterImg from '@/assets/IMG_4673.webp'
import exteriorWorkImg from '@/assets/IMG_3919_edited.webp'
import bigRoofImg from '@/assets/big_roof.webp'
import { BUSINESS } from '@/lib/business'

// From lg up the grid is five columns: rows alternate a wide card (3 columns)
// with a narrow one (2 columns), so the block has a rhythm instead of four
// equal tiles. The photo ratios are chosen so a wide and a narrow photo come
// out the same height, keeping both cards in a row level. Below lg every card
// is the same width and uses 3:2. `sizes` follows the same layout so each
// photo is downloaded at the width it is shown.
const SIZES_BELOW_LG = '(min-width: 640px) calc(50vw - 64px), calc(100vw - 96px)'
const WIDE = {
  span: 'lg:col-span-3',
  aspect: 'aspect-[3/2] lg:aspect-[16/9]',
  sizes: `(min-width: 1280px) 680px, (min-width: 1024px) calc(60vw - 90px), ${SIZES_BELOW_LG}`,
}
const NARROW = {
  span: 'lg:col-span-2',
  aspect: 'aspect-[3/2] lg:aspect-[9/8]',
  sizes: `(min-width: 1280px) 450px, (min-width: 1024px) calc(40vw - 80px), ${SIZES_BELOW_LG}`,
}

const items = [
  {
    title: 'Roofing',
    description: 'Premium protection built for Texas weather.',
    Icon: IconHammer,
    layout: WIDE,
    image: { src: bigRoofImg, alt: `Aerial view of a roofing project by ${BUSINESS.name}` },
  },
  {
    title: 'Exterior',
    description: 'Painting, stucco, and exterior finish work that lasts.',
    Icon: IconHome2,
    layout: NARROW,
    image: { src: exteriorWorkImg, alt: `Exterior finish work by ${BUSINESS.name}`, position: 'object-[50%_60%]' },
  },
  {
    title: 'Home Improvement',
    description: 'Upgrades and repairs that raise the value of your home.',
    Icon: IconHomeCog,
    layout: NARROW,
    image: { src: gutterImg, alt: `Copper gutter installation by ${BUSINESS.name}`, position: 'object-[50%_78%]' },
  },
  {
    title: 'Decks & Outdoor Living',
    description: 'Custom decks, patios, and outdoor spaces built for how Texans actually live.',
    Icon: IconFence,
    layout: WIDE,
    image: { src: backyardDeckImg, alt: `Custom backyard deck built by ${BUSINESS.name}` },
  },
]
---

<section id="services" class="py-24 lg:py-28 bg-bg">
  <div class="max-w-[1260px] mx-auto px-8 lg:px-12">

    <div data-reveal class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-16 reveal">
      <div>
        <h2
          class="font-heading font-bold leading-tight text-text"
          style="font-size: clamp(2.2rem, 4vw, 3.2rem)"
        >
          Our Services
        </h2>
      </div>
      <a
        href="#contact"
        class="self-start sm:self-auto text-[0.76rem] font-semibold tracking-[0.1em] uppercase pb-0.5 border-b border-text text-text hover:text-accent-ink hover:border-accent-ink transition-colors duration-200"
      >
        Get a Quote <span aria-hidden="true">→</span>
      </a>
    </div>

    {/* One column on phones, two equal columns from 640px, and the
        wide/narrow rows from 1024px. The reveal sits on a wrapper so its
        transition and stagger delay do not override the card's own hover
        transition. */}
    <div data-reveal="0.06" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:gap-5 lg:grid-cols-5">
      {items.map(({ title, description, Icon, layout, image }, i) => (
        <div class={`${layout.span} reveal delay-${i + 1}`}>
          <ServiceCard
            href="#contact"
            linkLabel={`${title}: get a quote`}
            cta="Get a Quote"
            title={title}
            description={description}
            image={{ ...image, aspect: layout.aspect, sizes: layout.sizes }}
            class="h-full"
          >
            <Icon slot="icon" aria-hidden="true" className="h-5 w-5 shrink-0 text-accent" />
          </ServiceCard>
        </div>
      ))}
    </div>

  </div>
</section>
