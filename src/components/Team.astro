---
import { Image } from 'astro:assets'
import alanImg from '@/assets/alan.webp'
import danImg from '@/assets/dan.webp'
import { BUSINESS } from '@/lib/business'

// From sm the second portrait drops 4rem (sm:mt-16), so the first bio pulls up by the same (sm:-mt-16).
const team = [
  {
    name: 'Alan',
    role: 'Co-owner',
    bio: "Alan co-founded Royal Crest on a simple principle: build it right, or don't build it at all. He oversees every project personally, holding each job to the standard of craftsmanship Dallas expects from Royal Crest.",
    src: alanImg,
    objectPosition: 'center 10%',
    zoom: 1,
    figureClass: 'col-start-1 row-start-1',
    bioClass: 'col-span-2 row-start-2 sm:col-span-1 sm:col-start-1 sm:-mt-16',
  },
  {
    name: 'Daniel',
    role: 'Co-owner',
    bio: 'Daniel co-founded Royal Crest and keeps every job on schedule and on budget, coordinating trades and inspections so clients never have to. His background in luxury renovation means no detail goes unchecked.',
    src: danImg,
    objectPosition: 'center top',
    // The zoom crops out a dark strip along the bottom edge of the file.
    zoom: 1.05,
    figureClass: 'col-start-2 row-start-1 sm:mt-16',
    bioClass: 'col-span-2 row-start-3 sm:col-span-1 sm:col-start-2 sm:row-start-2',
  },
]
---

<section id="about" class="py-24 lg:py-28 bg-bg">
  <div class="max-w-[1260px] mx-auto px-8 lg:px-12">
    <div class="grid grid-cols-1 gap-y-10 lg:grid-cols-12 lg:gap-x-16">
      <div data-reveal class="lg:col-span-4 reveal">
        <h2
          class="font-heading font-bold leading-tight text-text"
          style="font-size: clamp(2.2rem, 4vw, 3.2rem)"
        >
          Our Team
        </h2>
      </div>

      <div
        data-reveal="0.08"
        class="lg:col-span-8 grid grid-cols-2 content-start gap-x-4 gap-y-5 sm:gap-x-6 reveal"
      >
        {team.map((member) => (
          <figure class={member.figureClass}>
            <div class="overflow-hidden rounded-xl">
              <Image
                src={member.src}
                alt={`${member.name}, ${member.role} at ${BUSINESS.name}`}
                widths={[400, 600, 800]}
                sizes="(min-width: 1280px) 370px, (min-width: 1024px) calc(33vw - 50px), calc(50vw - 44px)"
                class="aspect-[4/5] w-full object-cover"
                style={`filter: saturate(0.9) brightness(1.02); object-position: ${member.objectPosition}; transform: scale(${member.zoom}); transform-origin: center top`}
              />
            </div>
            <figcaption class="mt-4">
              <h3 class="font-heading font-bold text-lg sm:text-xl text-text">{member.name}</h3>
              <p class="mt-0.5 text-sm text-text/65">{member.role}</p>
            </figcaption>
          </figure>
        ))}
        {team.map((member) => (
          <p class={`text-[0.88rem] leading-[1.78] text-text/70 ${member.bioClass}`}>{member.bio}</p>
        ))}
      </div>
    </div>
  </div>
</section>
