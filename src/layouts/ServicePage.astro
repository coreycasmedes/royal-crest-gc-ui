---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import Base from './Base.astro'
import Header from '@/components/Header'
import Badges from '@/components/Badges.astro'
import Testimonials from '@/components/Testimonials.astro'
import Contact from '@/components/Contact.astro'
import Footer from '@/components/Footer.astro'
import MobileActionBar from '@/components/MobileActionBar'
import ProjectCards from '@/components/service/ProjectCards.astro'
import { BUSINESS, telHref } from '@/lib/business'
import { page, section } from '@/lib/links'
import { getProjects } from '@/lib/projects'
import { SERVICES, type ServiceKey } from '@/lib/services'
import { TESTIMONIALS } from '@/lib/testimonials'
import { breadcrumbList, serviceOffer } from '@/lib/structured-data'

interface Props {
  service: ServiceKey
  title: string
  description: string
  heading: string
  intro: string
  photo: { src: ImageMetadata; alt: string; position?: string }
  offerings: { name: string; detail?: string }[]
  showPartners?: boolean
}

const { service, title, description, heading, intro, photo, offerings, showPartners = false } = Astro.props
const { name, path, formOption } = SERVICES[service]
const projects = await getProjects(service)
const testimonials = TESTIMONIALS.filter((t) => t.service === service)
const jsonLd = [
  serviceOffer(name, path, description),
  breadcrumbList([{ name: 'Home', path: '' }, { name, path }]),
]

const CONTAINER = 'max-w-[1260px] mx-auto px-8 lg:px-12'
const H2_CLASS = 'font-heading font-bold leading-tight text-text'
const H2_SIZE = 'font-size: clamp(2.2rem, 4vw, 3.2rem)'
const OFFERING_COLUMNS = offerings.length % 3 === 0 ? 'sm:grid-cols-2 lg:grid-cols-3' : 'sm:grid-cols-2'
const owners = [
  { name: 'Alan', detail: 'Oversees every project personally, holding each job to the standard of craftsmanship Dallas expects.' },
  { name: 'Daniel', detail: 'Keeps every job on schedule and on budget, coordinating trades and inspections so you never have to.' },
]
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <Header client:idle quoteHref="#contact" />
  <main>
    <section class="bg-bg pt-32 pb-16 lg:pt-40 lg:pb-24">
      <div class={`${CONTAINER} grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16`}>
        <div>
          <h1
            class="font-heading font-black leading-[1.05] tracking-tight text-text text-balance"
            style="font-size: clamp(2.6rem, 6vw, 4.5rem)"
          >
            {heading}
          </h1>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-pretty text-text/70 md:text-lg">{intro}</p>
          <div id="hero-actions" class="mt-8 flex flex-wrap gap-2">
            <a
              href="#contact"
              class="rounded-2xl px-8 py-3 text-center text-[0.78rem] font-semibold tracking-[0.08em] uppercase bg-deep text-bg hover:bg-accent-ink transition-colors duration-300"
            >
              Get a Quote
            </a>
            <a
              href={telHref}
              class="rounded-2xl border border-text/20 px-8 py-3 text-center text-[0.78rem] font-semibold tracking-[0.08em] uppercase text-text hover:border-text transition-colors duration-300"
            >
              Call {BUSINESS.phone.display}
            </a>
          </div>
        </div>
        <Image
          src={photo.src}
          alt={photo.alt}
          widths={[640, 960, 1280]}
          sizes="(min-width: 1280px) 560px, (min-width: 1024px) calc(50vw - 80px), calc(100vw - 64px)"
          loading="eager"
          fetchpriority="high"
          class={`aspect-[4/3] w-full rounded-xl object-cover ${photo.position ?? 'object-center'}`}
          style="filter: saturate(0.9) brightness(1.02)"
        />
      </div>
    </section>

    <section class="bg-bg py-20 lg:py-24">
      <div class={CONTAINER}>
        <h2 data-reveal class={`${H2_CLASS} reveal`} style={H2_SIZE}>What We Do</h2>
        <ul data-reveal="0.08" class={`mt-12 grid grid-cols-1 ${OFFERING_COLUMNS} gap-px bg-surface border border-surface`}>
          {offerings.map((offering, i) => (
            <li class={`bg-bg p-8 reveal delay-${(i % 6) + 1}`}>
              <h3 class="font-heading text-lg font-bold leading-snug text-text">{offering.name}</h3>
              {offering.detail && <p class="mt-2 text-[0.95rem] leading-relaxed text-text/70">{offering.detail}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>

    {showPartners && <Badges />}

    <section class="bg-bg py-20 lg:py-24">
      <div class={CONTAINER}>
        <h2 data-reveal class={`${H2_CLASS} reveal`} style={H2_SIZE}>Who Runs Your Job</h2>
        <div data-reveal="0.08" class="mt-12 grid grid-cols-1 gap-10 sm:grid-cols-2">
          {owners.map((owner, i) => (
            <div class={`reveal delay-${i + 1} border-t border-surface pt-6`}>
              <h3 class="font-heading text-lg font-bold text-text">{owner.name}, Co-owner</h3>
              <p class="mt-2 max-w-md text-[0.95rem] leading-relaxed text-text/70">{owner.detail}</p>
            </div>
          ))}
        </div>
        <a
          href={section('about')}
          class="mt-10 inline-block border-b border-text pb-0.5 text-[0.76rem] font-semibold tracking-[0.1em] uppercase text-text hover:border-accent-ink hover:text-accent-ink transition-colors duration-200"
        >
          Meet the Team <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    {projects.length > 0 && (
      <section class="bg-bg py-20 lg:py-24">
        <div class={CONTAINER}>
          <div class="mb-12 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
            <h2 data-reveal class={`${H2_CLASS} reveal`} style={H2_SIZE}>Recent {name} Projects</h2>
            <a
              href={page('projects/')}
              class="self-start sm:self-auto border-b border-text pb-0.5 text-[0.76rem] font-semibold tracking-[0.1em] uppercase text-text hover:border-accent-ink hover:text-accent-ink transition-colors duration-200"
            >
              All Projects <span aria-hidden="true">→</span>
            </a>
          </div>
          <ProjectCards projects={projects} />
        </div>
      </section>
    )}

    {testimonials.length > 0 && <Testimonials items={testimonials} />}

    <section class="bg-bg py-20 lg:py-24">
      <div class={CONTAINER}>
        <h2 data-reveal class={`${H2_CLASS} reveal`} style={H2_SIZE}>Areas We Serve</h2>
        <ul class="mt-10 flex flex-wrap gap-2">
          {BUSINESS.areaServed.map((city) => (
            <li class="rounded-2xl border border-surface px-5 py-2 text-[0.9rem] text-text">{city}</li>
          ))}
        </ul>
        <p class="mt-6 text-[0.95rem] text-text/70">Service area: {BUSINESS.serviceArea}</p>
      </div>
    </section>

    <Contact service={formOption} />
  </main>
  <Footer />
  <MobileActionBar client:idle quoteHref="#contact" />
</Base>
