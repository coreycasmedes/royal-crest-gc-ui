---
import '@/styles/global.css'
import Seo from '@/components/Seo.astro'
import bodyFont from '@/assets/fonts/LibreFranklin-Variable.woff2?url'
import { page } from '@/lib/links'

interface Props {
  title: string
  description: string
  noindex?: boolean
  jsonLd?: Record<string, unknown>[]
}

const { title, description, noindex, jsonLd } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- sizes="32x32" on the ICO stops Chrome preferring it over the SVG; the 96px PNG is for Google Search, which skips SVG -->
    <link rel="icon" href={page('favicon.ico')} sizes="32x32" />
    <link rel="icon" href={page('icon.svg')} type="image/svg+xml" />
    <link rel="icon" href={page('favicon-96.png')} type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href={page('apple-touch-icon.png')} />
    <link rel="manifest" href={page('manifest.webmanifest')} />
    <meta name="theme-color" content="#899878" />
    <Seo title={title} description={description} noindex={noindex} jsonLd={jsonLd} />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <noscript><style>.reveal { opacity: 1; transform: none; }</style></noscript>
  </head>
  <body>
    <slot />

    <script>
      const DEFAULT_REVEAL_THRESHOLD = 0.12
      document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((revealRoot) => {
        const threshold = Number(revealRoot.dataset.reveal) || DEFAULT_REVEAL_THRESHOLD
        const observer = new IntersectionObserver(
          ([entry]) => {
            if (!entry.isIntersecting) return
            observer.disconnect()
            if (revealRoot.classList.contains('reveal')) revealRoot.classList.add('visible')
            revealRoot.querySelectorAll('.reveal').forEach((el) => el.classList.add('visible'))
          },
          { threshold },
        )
        observer.observe(revealRoot)
      })
    </script>
  </body>
</html>
