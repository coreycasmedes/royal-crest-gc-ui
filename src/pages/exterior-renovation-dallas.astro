---
import ServicePage from '@/layouts/ServicePage.astro'
import exteriorWorkImg from '@/assets/IMG_3919_edited.webp'
import { BUSINESS } from '@/lib/business'
---

<ServicePage
  service="exterior"
  title={`Dallas Exterior Renovations | ${BUSINESS.name}`}
  description={`Exterior painting, stucco, wood trim, copper gutters and finish work for historic and modern homes in Dallas and the Park Cities. Request a free estimate.`}
  heading="Exterior Renovation Services in Dallas"
  intro={`Painting, stucco, and exterior finish work that lasts. ${BUSINESS.name} renovates the exteriors of historic and modern homes across Dallas and the Park Cities, with a co-owner overseeing every job.`}
  photo={{ src: exteriorWorkImg, alt: `Exterior finish work by ${BUSINESS.name}`, position: 'object-[50%_60%]' }}
  offerings={[
    { name: 'Exterior Painting' },
    { name: 'Stucco' },
    { name: 'Wood Trim and Fascia', detail: 'Trim repairs and complete fascia replacement, matched to the character of historic homes.' },
    { name: 'Copper Gutters', detail: 'Half-round copper gutters with copper gutter screens, downspouts and copper metal canopies.' },
    { name: 'Custom Shutters', detail: 'Custom fabricated louvered window shutters.' },
    { name: 'Exterior Finish Work', detail: 'Interior and exterior finishes on both historic and modern homes are our specialty.' },
  ]}
/>
