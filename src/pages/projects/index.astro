---
import Base from '@/layouts/Base.astro'
import Header from '@/components/Header'
import Footer from '@/components/Footer.astro'
import ProjectCards from '@/components/service/ProjectCards.astro'
import { BUSINESS } from '@/lib/business'
import { page, section } from '@/lib/links'
import { getProjects } from '@/lib/projects'
import { SERVICES } from '@/lib/services'
import { breadcrumbList } from '@/lib/structured-data'

const projects = await getProjects()
const LINK_CLASS = 'border-b border-text pb-0.5 text-[0.76rem] font-semibold tracking-[0.1em] uppercase text-text hover:border-accent-ink hover:text-accent-ink transition-colors duration-200'
---

<Base
  title={`Projects | ${BUSINESS.name}`}
  description={`Recent roofing and exterior projects by ${BUSINESS.name} in Dallas, Plano, Frisco and Highland Park.`}
  jsonLd={[breadcrumbList([{ name: 'Home', path: '' }, { name: 'Projects', path: 'projects/' }])]}
>
  <Header client:idle />
  <main class="bg-bg pt-32 pb-24 lg:pt-40 lg:pb-28">
    <div class="max-w-[1260px] mx-auto px-8 lg:px-12">
      <h1
        class="font-heading font-black leading-[1.05] tracking-tight text-text"
        style="font-size: clamp(2.6rem, 6vw, 4.5rem)"
      >
        Projects
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-pretty text-text/70 md:text-lg">
        Recent roofing and exterior work by {BUSINESS.name} across the Dallas area.
      </p>
      <div class="mt-8 flex flex-wrap gap-x-8 gap-y-4">
        {Object.values(SERVICES).map(({ name, path }) => (
          <a href={page(path)} class={LINK_CLASS}>{name} <span aria-hidden="true">→</span></a>
        ))}
      </div>

      <div class="mt-16">
        <ProjectCards projects={projects} headingLevel="h2" aboveFold />
      </div>

      <a
        href={section('contact')}
        class="mt-20 inline-block rounded-2xl px-8 py-3 text-[0.78rem] font-semibold tracking-[0.08em] uppercase bg-deep text-bg hover:bg-accent-ink transition-colors duration-300"
      >
        Get a Quote
      </a>
    </div>
  </main>
  <Footer />
</Base>
