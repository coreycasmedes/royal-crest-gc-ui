---
import ServicePage from '@/layouts/ServicePage.astro'
import bigRoofImg from '@/assets/big_roof.webp'
import { BUSINESS } from '@/lib/business'
---

<ServicePage
  service="roofing"
  title={`Roofing in Dallas, TX | ${BUSINESS.name}`}
  description={`Roofing for homes in Dallas, Plano, Frisco and Highland Park, with GAF, CertainTeed and Brava materials. Call ${BUSINESS.phone.display} or get a quote.`}
  heading="Roofing in Dallas, TX"
  intro={`Premium protection built for Texas weather. ${BUSINESS.name} installs roofs on homes across Dallas, Plano, Frisco and Highland Park, with a co-owner overseeing every job.`}
  photo={{ src: bigRoofImg, alt: `Aerial view of a roofing project by ${BUSINESS.name}` }}
  offerings={[
    { name: 'New Roofs', detail: 'Complete roof installations on homes in Dallas and the suburbs, from Lakewood and Prestonwood to Frisco.' },
    { name: 'Trusted Materials', detail: 'We work with GAF, CertainTeed and Brava, and source our materials through ABC Supply.' },
  ]}
  showPartners
/>
